# Copy to terraform.tfvars for a one-off laptop apply, or use
#   terraform plan -var-file=environments/dev.tfvars
#
# Every value below is also documented in variables.tf.

project_name = "dualvpc"
environment  = "dev"
aws_region   = "us-east-1"
owner        = "platform-team"

additional_tags = {
  CostCenter = "engineering"
}

public_vpc_name  = "edge-vpc"
private_vpc_name = "workload-vpc"

public_vpc_cidr  = "10.10.0.0/16"
private_vpc_cidr = "10.11.0.0/16"

availability_zones = ["us-east-1a", "us-east-1b"]
az_count           = 2

public_subnet_cidrs  = ["10.10.0.0/24", "10.10.1.0/24"]
private_subnet_cidrs = ["10.11.10.0/24", "10.11.11.0/24"]

instance_type        = "t3.micro"
asg_min_size         = 2
asg_desired_capacity = 2
asg_max_size         = 4
root_volume_size_gb  = 8

enable_cpu_autoscaling     = true
cpu_target_percent         = 60
enable_deletion_protection = false
enable_flow_logs           = false
enable_network_acls        = true
enable_ssm_endpoints       = true
ssm_endpoint_ha            = false
enable_alb_access_logs     = false
detailed_monitoring        = false

allowed_ingress_cidrs            = ["0.0.0.0/0"]
public_alb_https_certificate_arn = ""
health_check_path                = "/"
web_listen_port                  = 80
alb_idle_timeout                 = 60
alb_deregistration_delay         = 30

# --- GitHub → Docker on EC2 -------------------------------------------------
# Preferred: PAT already in SSM (never enters Terraform state).
github_repository             = "your-org/your-app"
github_branch                 = "main"
github_pat_ssm_parameter_name = "/dualvpc/dev/github-pat"
# github_pat                  = ""   # last resort — lands in Terraform state
dockerfile_directory          = "."
container_port                = 80
# enable_nat_gateway is implied when github_repository is set
private_nat_subnet_cidrs      = []
